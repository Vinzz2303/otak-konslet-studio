{
  "name": "otak-konslet-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Otak Konslet Studio - Local 2D Animation Production Engine & Studio Dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,VITE\" -c \"blue,green\" \"tsx server/index.ts\" \"vite\"",
    "dev:vite": "vite",
    "dev:server": "tsx server/index.ts",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "render": "tsx scripts/render-episode.ts",
    "test:voices": "tsx scripts/test-voice-preview.ts",
    "generate:audio": "tsx scripts/generate-demo-audio.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@remotion/bundler": "4.0.274",
    "@remotion/cli": "4.0.274",
    "@remotion/player": "4.0.274",
    "@remotion/renderer": "4.0.274",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.274"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
